import bpy
from math import radians, asin, sin
from mathutils import Vector, Quaternion, Matrix

FPS = 30
NEW_ACTION_NAME = "funkydance"

def find_rig():
    ob = bpy.context.active_object
    if ob and ob.type == 'ARMATURE':
        return ob
    if "Human.rig" in bpy.data.objects and bpy.data.objects["Human.rig"].type == 'ARMATURE':
        return bpy.data.objects["Human.rig"]
    for ob in bpy.context.scene.objects:
        if ob.type == 'ARMATURE':
            return ob
    raise RuntimeError("No armature found - select your Human.rig and run again.")

rig = find_rig()
pbones = rig.pose.bones

ROLES = {
    "spine_low": ["spine04", "spine_01"],
    "chest":     ["spine02", "spine_03"],
    "head":      ["head"],
    "upper_L":   ["upperarm01.L", "upperarm02.L", "upperarm_l"],
    "upper_R":   ["upperarm01.R", "upperarm02.R", "upperarm_r"],
    "fore_L":    ["lowerarm01.L", "lowerarm02.L", "lowerarm_l"],
    "fore_R":    ["lowerarm01.R", "lowerarm02.R", "lowerarm_r"],
    "wrist_L":   ["wrist.L", "hand_l"],
    "wrist_R":   ["wrist.R", "hand_r"],
    "thigh_L":   ["upperleg01.L", "thigh_l"],
    "thigh_R":   ["upperleg01.R", "thigh_r"],
    "shin_L":    ["lowerleg01.L", "calf_l"],
    "shin_R":    ["lowerleg01.R", "calf_r"],
    "foot_L":    ["foot.L", "foot_l"],
    "foot_R":    ["foot.R", "foot_r"],
}
role_bones = {r: [n for n in names if n in pbones] for r, names in ROLES.items()}
missing = [r for r, b in role_bones.items() if not b]
if missing:
    print("WARNING - couldn't find bones for:", missing)
    print("Bones in this rig:", [b.name for b in pbones])

world_to_arm = rig.matrix_world.to_3x3().normalized().inverted()

def A(x, y, z):
    return (world_to_arm @ Vector((x, y, z))).normalized()

def rot(axis, deg):
    ax = {"X": Vector((1, 0, 0)), "Y": Vector((0, 1, 0)), "Z": Vector((0, 0, 1))}[axis]
    return Quaternion(ax, radians(deg))
def leg_len(names):
    return sum(pbones[n].bone.length for n in names if n in pbones)

THIGH_LEN = leg_len(["upperleg01.L", "upperleg02.L", "thigh_l"])
SHIN_LEN  = leg_len(["lowerleg01.L", "lowerleg02.L", "calf_l"])

def knees(bend_deg, hip=0):
    t = bend_deg
    s = 0
    if t != 0 and THIGH_LEN > 0 and SHIN_LEN > 0:
        s = asin(min(1.0, THIGH_LEN * sin(radians(t)) / SHIN_LEN)) * 57.2958
    d = {}
    for side in "LR":
        k = (FEET_IN if side == "L" else -FEET_IN) - hip
        d["thigh_" + side] = ("rot", rot("X", -t) @ rot("Y", k))
        d["shin_" + side]  = ("rot", rot("X", t + s))
        d["foot_" + side]  = ("rot", rot("Y", -k) @ rot("X", -s))
    return d

UP     = (0, 0, 1)
DOWN   = (0, 0, -1)
INWARD = (-1, 0, 0)

def arm(side, upper, fore, palm=UP, turn=0):
    m = 1 if side == "L" else -1
    R = rot("Z", turn)
    def T(x, y, z):
        v = R @ Vector((m * x, y, z))
        return A(v.x, v.y, v.z)
    p = T(*palm)
    return {
        "upper_" + side: ("dir", T(*upper)),
        "fore_" + side:  ("aim", T(*fore), p),
        "wrist_" + side: ("aim", T(*fore), p),
    }

def arm_relaxed(side, upper, fore):
    m = 1 if side == "L" else -1
    return {
        "upper_" + side: ("dir", A(m * upper[0], upper[1], upper[2])),
        "fore_" + side:  ("dir", A(m * fore[0], fore[1], fore[2])),
    }

def body(nod=0, turn=0, lean=0):
    return {
        "spine_low": ("rot", rot("Z", turn * 0.4) @ rot("Y", lean * 0.4)),
        "chest":     ("rot", rot("Z", turn * 0.4) @ rot("Y", lean * 0.6) @ rot("X", nod * 0.5)),
        "head":      ("rot", rot("Z", turn * 0.2) @ rot("Y", -lean * 0.5) @ rot("X", nod)),
    }

def P(*ds):
    out = {}
    for d in ds:
        out.update(d)
    return out

# +X = her left, -Y = forward, +Z = up   (arm numbers are for her LEFT arm)
ARMS_CLOSED = ((0.22, 0.10, -0.97), (0.35, -0.85, 0.30))   # elbows tucked, fists at chest
ARMS_OPEN   = ((0.70, -0.05, -0.71), (0.92, -0.20, 0.25))  # arms open to the sides
ARMS_DOWN   = ((0.15, 0.02, -0.99), (0.12, -0.08, -0.99))  # standing normally, arms by her sides

BPM        = 85      # bops per minute - lower = slower
BEAT       = round(FPS * 60 / BPM)
KNEE_BEND  = 30      # degrees - bigger = deeper bop
FEET_IN    = 4       # degrees - bigger = feet closer together
FIST_CURL  = 60      # degrees per finger joint
THUMB_CURL = 25
TURN       = 12      # degrees she turns each time she straightens

STAND = P(arm_relaxed("L", *ARMS_DOWN), arm_relaxed("R", *ARMS_DOWN), knees(0), body())

def straight(turn):
    return P(arm("L", *ARMS_OPEN, UP, turn), arm("R", *ARMS_OPEN, UP, turn),
             knees(0), body(turn=turn), {"_fist": True})

BENT = P(arm("L", *ARMS_CLOSED, UP), arm("R", *ARMS_CLOSED, UP),
         knees(KNEE_BEND), body(nod=4), {"_fist": True})

# stand -> 2 bops (turn left, turn right) -> stand
TIMELINE = [
    (1,                 STAND),
    (1 + BEAT,          straight(TURN)),
    (1 + BEAT * 3 // 2, BENT),
    (1 + BEAT * 2,      straight(-TURN)),
    (1 + BEAT * 5 // 2, BENT),
    (1 + BEAT * 3,      straight(0)),
    (1 + BEAT * 4,      STAND),
]
END_FRAME = 1 + BEAT * 4

def hierarchy(bones):
    order = []
    def walk(pb):
        order.append(pb)
        for c in pb.children:
            walk(c)
    for pb in bones:
        if pb.parent is None:
            walk(pb)
    return order

ORDER = hierarchy(pbones)
ROOTS = [pb for pb in pbones if pb.parent is None]
FEET = [pbones[n] for n in ("foot.L", "foot.R", "foot_l", "foot_r") if n in pbones]
FINGER_WORDS = ("finger", "thumb", "index", "middle", "ring", "pinky")

def palm_axis(pb, side):
    r = pb.bone.matrix_local.to_3x3().normalized()
    d = Vector(r.col[1])
    inward = A(-1, 0, 0) if side == "L" else A(1, 0, 0)
    n = (inward - d * d.dot(inward)).normalized()
    best = max([Vector((1,0,0)), Vector((-1,0,0)), Vector((0,0,1)), Vector((0,0,-1))],
               key=lambda a: (r @ a).dot(n))
    return best

def side_of(name):
    return "L" if name.endswith((".L", "_l", "_L")) else "R"

def under_wrist(pb):
    p = pb.parent
    while p:
        if p.name in ("wrist.L", "wrist.R", "hand_l", "hand_r"):
            return p
        p = p.parent
    return None

def apply_pose(pose, offset=Vector((0, 0, 0))):
    for pb in pbones:
        pb.rotation_mode = 'QUATERNION'
        pb.rotation_quaternion = Quaternion()
        pb.location = (0, 0, 0)
        pb.scale = (1, 1, 1)
    bpy.context.view_layer.update()
    for pb in ROOTS:
        M = pb.matrix.copy()
        M.translation = M.translation + offset
        pb.matrix = M
    targets = {}
    for role, spec in pose.items():
        for name in role_bones.get(role, []):
            targets[name] = spec
    for pb in ORDER:
        spec = targets.get(pb.name)
        wrist = under_wrist(pb)
        is_finger = pose.get("_fist") and wrist and any(w in pb.name.lower() for w in FINGER_WORDS) and "metacarpal" not in pb.name.lower()
        if not spec and not is_finger:
            continue
        bpy.context.view_layer.update()
        M = pb.matrix.copy()
        M3 = M.to_3x3().normalized()
        if is_finger:
            d = Vector(M3.col[1])
            n = (wrist.matrix.to_3x3().normalized() @ palm_axis(wrist, side_of(wrist.name)))
            axis = d.cross(n)
            if axis.length < 1e-6:
                continue
            ang = THUMB_CURL if ("thumb" in pb.name.lower() or "finger1" in pb.name) else FIST_CURL
            R3 = Quaternion(axis.normalized(), radians(ang)).to_matrix() @ M3
        elif spec[0] == "dir":
            R3 = Vector(M3.col[1]).rotation_difference(spec[1]).to_matrix() @ M3
        elif spec[0] == "rot":
            R3 = (world_to_arm @ spec[1].to_matrix() @ world_to_arm.inverted()) @ M3
        else:
            y = spec[1].normalized()
            p = (spec[2] - y * spec[2].dot(y)).normalized()
            a = palm_axis(pb, side_of(pb.name))
            yl = Vector((0, 1, 0))
            L = Matrix((a, yl, a.cross(yl))).transposed()
            W = Matrix((p, y, p.cross(y))).transposed()
            R3 = W @ L.transposed()
        newM = R3.to_4x4()
        newM.translation = M.translation
        pb.matrix = newM
    bpy.context.view_layer.update()

def foot_drop(pose):
    if not FEET:
        return Vector((0, 0, 0))
    apply_pose(pose)
    moved = Vector((0, 0, 0))
    for f in FEET:
        moved += f.head - f.bone.head_local
    return -moved / len(FEET)

if rig.animation_data:
    old = rig.animation_data.action
    for track in list(rig.animation_data.nla_tracks):
        rig.animation_data.nla_tracks.remove(track)
    rig.animation_data.action = None
    if old:
        bpy.data.actions.remove(old)
if NEW_ACTION_NAME in bpy.data.actions:
    bpy.data.actions.remove(bpy.data.actions[NEW_ACTION_NAME])

prev = {}
for frame, pose in TIMELINE:
    apply_pose(pose, foot_drop(pose))
    for pb in pbones:
        q = pb.rotation_quaternion.copy()
        if pb.name in prev and prev[pb.name].dot(q) < 0:
            q.negate()
        prev[pb.name] = q.copy()
        pb.rotation_quaternion = q
        pb.keyframe_insert("rotation_quaternion", frame=frame)
    for pb in ROOTS:
        pb.keyframe_insert("location", frame=frame)

if rig.animation_data and rig.animation_data.action:
    rig.animation_data.action.name = NEW_ACTION_NAME

scene = bpy.context.scene
scene.render.fps = FPS
scene.frame_start = 1
scene.frame_end = END_FRAME
scene.frame_set(1)
print("Done - funkydance is now on", rig.name)